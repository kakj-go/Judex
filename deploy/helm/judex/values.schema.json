{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "environment": {
      "enum": [
        "development",
        "production",
        "test"
      ]
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "global": {
      "type": "object",
      "required": [
        "sandboxAPIKeySecret",
        "sandboxAPIKeyManaged"
      ],
      "properties": {
        "sandboxAPIKeySecret": {
          "type": "string",
          "minLength": 1
        },
        "sandboxAPIKeyManaged": {
          "type": "boolean"
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "embedded": {
          "$ref": "#/definitions/embedded"
        },
        "external": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "sslMode": {
              "enum": [
                "disable",
                "require",
                "verify-ca",
                "verify-full"
              ]
            }
          }
        }
      }
    },
    "objectStorage": {
      "type": "object",
      "properties": {
        "embedded": {
          "$ref": "#/definitions/embedded"
        }
      }
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  },
  "definitions": {
    "embedded": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "storage": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        },
        "storageClass": {
          "type": "string"
        }
      }
    }
  }
}
